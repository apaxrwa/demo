# Settings for deploying and verifying the contracts on Sepolia.
# Copy this file to smart-contracts/.env (git-ignored) and fill in real values.
# Local commands (compile, test, node, demo:metals) need none of these.

# RPC endpoint for Sepolia, e.g. from Alchemy or Infura (free tiers work)
SEPOLIA_RPC_URL=

# Private key of the deploying account (a dedicated test-only wallet, never one holding real funds)
SEPOLIA_PRIVATE_KEY=

# Etherscan API key, used by `npx hardhat verify`
ETHERSCAN_API_KEY=
