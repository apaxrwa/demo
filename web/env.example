# Every setting the API understands. The shared development values are already in
# src/config/.config.env (committed). To override any of them on your machine only, put
# them in web/.env, which is git-ignored and loaded first.

NODE_ENV=development

# The HTTP port for the Express API (the Next.js frontend stays on 3000)
API_PORT=4000

# Comma-separated list of frontend origins allowed to call the API with cookies
FRONTEND_URL="mongodb+srv://yourprettygirl502_db_user:S64jp9XMQkeGsRmb@cluster0.pt7bc7w.mongodb.net/apax"

# MongoDB connection string (local install or a MongoDB Atlas cluster). MONGODB_URI also works.
# If the string names no database, "apax" is used. In development, leaving it unset (or the
# database being unreachable) makes the API use in-memory mock data instead.
MONGO_URI=mongodb://127.0.0.1:27017/apax

# JWT secrets: each must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=SldUX1JFRlJFU0hfU0VDVVJJVFlfS0VZX0lTX0ZPUl9TRVNTSU9OX0ZVTkNUSU9O
JWT_REFRESH_SECRET=aHR0cHM6Ly9qd3Qtc2VjcmV0LWtleS1zdGF0dXMudmVyY2VsLmFwcC9hcGkvdjE=
# Access token lifetime (refreshed automatically) and refresh cookie lifetime in days
JWT_EXPIRE=15m
COOKIE_EXPIRE=7

# Demo user created by `npm run seed` (optional overrides)
# SEED_DEMO_EMAIL=demo@apax.local
# SEED_DEMO_PASSWORD=DemoPass123!
# SEED_DEMO_WALLET=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# Chain indexer and reconciliation (optional; both must be set to enable)
# RPC_URL=http://127.0.0.1:8545
# APX_GOLD_ADDRESS=
# INDEXER_START_BLOCK=0
# INDEXER_CONFIRMATIONS=0
# INDEXER_POLL_MS=10000

# SendGrid (password reset emails)
SENDGRID_API_KEY=
SENDGRID_MAIL=
SENDGRID_RESET_TEMPLATEID=

# Cloudinary (optional avatar uploads)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend: where the browser should send API requests
NEXT_PUBLIC_API_URL=http://localhost:4000